{
  "name": "natours",
  "version": "1.0.0",
  "description": "learning node, express and mongodb",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "debug": "ndb server.js",
    "start:prod": "set NODE_ENV=production&& nodemon server.js",
    "watch:js": "esbuild ./public/js/index.js --bundle --outfile=./public/js/bundle.js --watch",
    "build:js": "esbuild ./public/js/index.js --bundle --minify --outfile=./public/js/bundle.js"
  },
  "author": "rohit",
  "license": "ISC",
  "dependencies": {
    "@exortek/express-mongo-sanitize": "^3.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-xss-sanitizer": "^2.0.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pug": "^3.0.4",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "ndb": "^1.1.5",
    "nodemon": "^3.1.14"
  }
}
